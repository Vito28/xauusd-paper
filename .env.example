# Active collector target. Change this pair only when fetching from MT5.
# The broker profile is always passed explicitly with ``--profile``.
GOLD_ENVIRONMENT=demo

# Use gold_market_demo for demo and gold_market_live for live.
GOLD_DATABASE_URL=postgresql+psycopg://gold_user:change-me@localhost:5432/gold_market_demo

# Read-only dashboard connections. Keep demo and live in separate databases.
# The HTML selector may choose only one of these configured connections.
GOLD_DASHBOARD_DEMO_DATABASE_URL=postgresql+psycopg://gold_user:change-me@localhost:5432/gold_market_demo
GOLD_DASHBOARD_LIVE_DATABASE_URL=postgresql+psycopg://gold_user:change-me@localhost:5432/gold_market_live

GOLD_MT5_TERMINAL_PATH=

# Dashboard live (dashboard/live.py). Polling MT5 hanya berjalan di Windows
# dengan terminal MT5 yang sudah login; di Linux/Docker statusnya "disconnected".
GOLD_LIVE_SYMBOL=XAUUSD
GOLD_LIVE_ENABLED=true
# Folder hasil technical.run (backtest/ dan live_bundle.joblib). Kosong = ./runs
# GOLD_RUNS_DIR=runs
GOLD_LOG_LEVEL=INFO
GOLD_SAFETY_LAG_SECONDS=5
GOLD_STORE_VALID_TICK_RAW_PAYLOAD=false

# Docker Compose development database. Compose builds GOLD_DATABASE_URL from
# these values and uses the PostgreSQL service hostname inside the network.
POSTGRES_DB=gold_market_demo
POSTGRES_USER=gold_user
POSTGRES_PASSWORD=change-me
